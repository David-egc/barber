function barber_form_contact_message_feedback_form_alter(&$form, &$form_state, $form_id)
{
    // Añadiendo  clase a todo el formulario
   $form['#prefix'] = '<div class="container-fluid ">';
  $form['#suffix'] = '</div>';
  // Añadiendo clases de bootstrap a campos de formulario
  $form['name']['#wrapper_attributes']['class'][] = ' col-md-6';
  $form['name']['#wrapper_attributes']['class'][] = ' col-12';
 $form['mail']['#wrapper_attributes']['class'][] = ' col-md-6';
  $form['mail']['#wrapper_attributes']['class'][] = ' col-12';
    if (isset($form['name']) && isset($form['mail'])) {

        // Div contenedor con estilos específicos
        $form['name']['#prefix'] = '
      <div class="row">
      ' . ($form['name']['#prefix'] ?? '');

        $form['mail']['#suffix'] = ($form['mail']['#suffix'] ?? '') . '</div>';
    }

    // Ocultando label de campos de formulario de contacto

    $form['name']['#label_attributes']['class'][] = 'visually-hidden';
      $form['mail']['#label_attributes']['class'][] = 'visually-hidden';
       $form['subject']['widget'][0]['value']['#label_attributes']['class'][] = 'visually-hidden';
        $form['message']['widget'][0]['value']['#label_attributes']['class'][] = 'visually-hidden';
 
   
    $form['name']['#attributes']['placeholder'] = 'Nombre *';
     $form['mail']['#attributes']['placeholder'] = 'Correo electrónico *';
      $form['subject']['widget'][0]['value']['#attributes']['placeholder'] = 'Asunto *';
       $form['message']['widget'][0]['#attributes']['placeholder'] = 'Mensaje *';

}

